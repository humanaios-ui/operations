{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanaios:research-assistant:job:v0.1",
  "title": "HumanAIOS Research Assistant Job v0.1",
  "description": "Proposed data-only contract for bounded public-source research. It does not implement a worker, persistence, authorization, or tool gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "intent_ref",
    "allowed_sources",
    "repository_pins",
    "agent_identity",
    "tool_allowlist",
    "data_classification",
    "budgets",
    "status",
    "checkpoint",
    "evidence",
    "duplicate_key",
    "human_decision_request",
    "final_receipt",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "humanaios.research_assistant.job.v0.1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^RAJ-[A-Za-z0-9._-]{1,64}$"
    },
    "intent_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": ["ISSUE", "RESOURCE_MINER_OPPORTUNITY", "TECHNICAL_QUESTION"]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "allowed_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_uri", "source_class", "authorization_ref"],
        "properties": {
          "source_uri": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "source_class": {
            "enum": ["PUBLIC_PRIMARY", "PUBLIC_SECONDARY", "SYNTHETIC_FIXTURE"]
          },
          "authorization_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_class": {
                  "const": "SYNTHETIC_FIXTURE"
                }
              },
              "required": ["source_class"]
            },
            "then": {
              "properties": {
                "source_uri": {
                  "pattern": "^https://example\\.org(?:/|$)"
                }
              }
            },
            "else": {
              "properties": {
                "source_uri": {
                  "pattern": "^https://[^/@?#]+(?:[/?#].*)?$"
                }
              }
            }
          }
        ]
      }
    },
    "repository_pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit_sha"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    },
    "agent_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "version", "session_id", "identity_status"],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "identity_status": {
          "const": "SELF_ASSERTED"
        }
      }
    },
    "tool_allowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public_source.read",
          "repository.snapshot.read",
          "issue.thread.read"
        ]
      }
    },
    "data_classification": {
      "enum": ["PUBLIC", "SYNTHETIC"]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_runtime_seconds",
        "max_cost_micro_usd",
        "max_tool_calls",
        "max_retries"
      ],
      "properties": {
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "max_cost_micro_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000000
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "status": {
      "enum": [
        "QUEUED",
        "RESEARCHING",
        "EVIDENCE_CHECK",
        "NEEDS_HUMAN",
        "COMPLETED_READ_ONLY",
        "BLOCKED",
        "FAILED"
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "event_sequence",
        "checkpoint_sha256",
        "updated_at",
        "retry_count",
        "resume_count",
        "durability_status"
      ],
      "properties": {
        "cursor": {
          "type": "string",
          "maxLength": 512
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "resume_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "durability_status": {
          "const": "UNVERIFIED"
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim",
          "epistemic_status",
          "source_uri",
          "source_locator",
          "retrieved_at",
          "source_version",
          "conflicting_evidence_refs",
          "freshness"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "epistemic_status": {
            "enum": [
              "OBSERVED",
              "SUPPORTED",
              "INFERRED",
              "HYPOTHESIZED",
              "UNVERIFIED",
              "CONTRADICTED"
            ]
          },
          "source_uri": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/@?#]+(?:[/?#].*)?$",
            "maxLength": 2048
          },
          "source_locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "supporting_excerpt": {
            "type": "string",
            "maxLength": 1000
          },
          "supporting_excerpt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "conflicting_evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "freshness": {
            "enum": ["CURRENT", "STALE", "UNKNOWN"]
          }
        },
        "anyOf": [
          {
            "required": ["supporting_excerpt"]
          },
          {
            "required": ["supporting_excerpt_sha256"]
          }
        ]
      }
    },
    "duplicate_key": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256 of canonical JSON containing intent_ref, allowed_sources, and repository_pins; a durable runtime must still consume it exactly once."
    },
    "human_decision_request": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/human_decision_request"
        }
      ]
    },
    "final_receipt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/final_receipt"
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_effect",
        "can_authorize",
        "can_execute",
        "merge_authority"
      ],
      "properties": {
        "authority_effect": {
          "const": "NONE"
        },
        "can_authorize": {
          "const": false
        },
        "can_execute": {
          "const": false
        },
        "merge_authority": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NEEDS_HUMAN"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "human_decision_request": {
            "$ref": "#/$defs/human_decision_request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED_READ_ONLY"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "final_receipt": {
            "$ref": "#/$defs/completed_receipt"
          }
        }
      }
    }
  ],
  "$defs": {
    "human_decision_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "state",
        "decision_required",
        "options",
        "implications",
        "missing_evidence",
        "recommendation",
        "recommendation_basis",
        "deadline",
        "permitted_next_step"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "const": "PENDING_HUMAN"
        },
        "decision_required": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "implications"],
            "properties": {
              "option": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "implications": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "implications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "recommendation_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["at", "source_uri"],
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "source_uri": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://[^/@?#]+(?:[/?#].*)?$",
                  "maxLength": 2048
                }
              }
            }
          ]
        },
        "permitted_next_step": {
          "const": "HUMAN_REVIEW_ONLY"
        }
      }
    },
    "final_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "payload_sha256",
        "result_status",
        "evidence_refs",
        "authority_effect",
        "external_actions",
        "human_approval"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EVT-[A-Za-z0-9._:-]+$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result_status": {
          "enum": ["COMPLETED_READ_ONLY", "BLOCKED", "FAILED"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "authority_effect": {
          "const": "NONE"
        },
        "external_actions": {
          "const": 0
        },
        "human_approval": {
          "const": false
        }
      }
    },
    "completed_receipt": {
      "allOf": [
        {
          "$ref": "#/$defs/final_receipt"
        },
        {
          "properties": {
            "result_status": {
              "const": "COMPLETED_READ_ONLY"
            }
          }
        }
      ]
    }
  }
}
