{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanaios.ai/schemas/humanaios_core_machine_v0_1.schema.json",
  "title": "HumanAIOS Core Machine v0.1 contracts",
  "oneOf": [
    {"$ref": "#/$defs/program"},
    {"$ref": "#/$defs/receipt"},
    {"$ref": "#/$defs/review_snapshot"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"
    },
    "id_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/opaque"}
    },
    "review_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "subject_head_sha", "reviews"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "subject_head_sha": {"$ref": "#/$defs/commit"},
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["review_id", "actor", "state", "submitted_at"],
            "properties": {
              "review_id": {"$ref": "#/$defs/opaque"},
              "actor": {"$ref": "#/$defs/opaque"},
              "state": {
                "enum": ["APPROVED", "CHANGES_REQUESTED", "DISMISSED"]
              },
              "submitted_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
              }
            }
          }
        }
      }
    },
    "pin_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "PIN_CONTEXT"},
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["program_id", "repository", "subject_head_sha", "policy_sha256", "purpose"],
          "properties": {
            "program_id": {"$ref": "#/$defs/opaque"},
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "subject_head_sha": {"$ref": "#/$defs/commit"},
            "policy_sha256": {"$ref": "#/$defs/sha256"},
            "purpose": {"$ref": "#/$defs/opaque"},
            "source_issue": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        }
      }
    },
    "observe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "OBSERVE"},
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "source_ref", "source_sha256", "epistemic_state"],
          "properties": {
            "id": {"$ref": "#/$defs/opaque"},
            "source_ref": {"$ref": "#/$defs/opaque"},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "epistemic_state": {
              "enum": ["OBSERVED", "ATTESTED", "UNKNOWN", "DISPUTED"]
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "CLAIM"},
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "claim_sha256", "evidence_ids", "epistemic_state"],
          "properties": {
            "id": {"$ref": "#/$defs/opaque"},
            "claim_sha256": {"$ref": "#/$defs/sha256"},
            "evidence_ids": {"$ref": "#/$defs/id_list"},
            "epistemic_state": {
              "enum": ["OBSERVED", "INFERRED", "UNKNOWN", "DISPUTED"]
            }
          }
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "CHALLENGE"},
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "claim_id", "state", "evidence_ids"],
          "properties": {
            "id": {"$ref": "#/$defs/opaque"},
            "claim_id": {"$ref": "#/$defs/opaque"},
            "state": {"enum": ["OPEN", "RESOLVED"]},
            "evidence_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/opaque"}
            }
          }
        }
      }
    },
    "warrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "WARRANT"},
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "claim_ids", "action", "scope", "reversible"],
          "properties": {
            "id": {"$ref": "#/$defs/opaque"},
            "claim_ids": {"$ref": "#/$defs/id_list"},
            "action": {"const": "EVALUATION_ADMISSION"},
            "scope": {"$ref": "#/$defs/opaque"},
            "reversible": {"type": "boolean"}
          }
        }
      }
    },
    "import_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "IMPORT_AUTHORITY"},
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "receipt_id", "warrant_id", "min_strength"],
          "properties": {
            "id": {"$ref": "#/$defs/opaque"},
            "receipt_id": {"$ref": "#/$defs/opaque"},
            "warrant_id": {"$ref": "#/$defs/opaque"},
            "min_strength": {"enum": ["ATTESTED", "CRYPTO_VERIFIED"]}
          }
        }
      }
    },
    "record_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "RECORD_ACTION"},
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "receipt_id", "authorization_receipt_id", "warrant_id"],
          "properties": {
            "id": {"$ref": "#/$defs/opaque"},
            "receipt_id": {"$ref": "#/$defs/opaque"},
            "authorization_receipt_id": {"$ref": "#/$defs/opaque"},
            "warrant_id": {"$ref": "#/$defs/opaque"}
          }
        }
      }
    },
    "record_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "RECORD_OUTCOME"},
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "receipt_id", "action_id"],
          "properties": {
            "id": {"$ref": "#/$defs/opaque"},
            "receipt_id": {"$ref": "#/$defs/opaque"},
            "action_id": {"$ref": "#/$defs/opaque"}
          }
        }
      }
    },
    "close": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "CLOSE"},
        "arg": {
          "type": "object",
          "maxProperties": 0
        }
      }
    },
    "halt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "HALT"},
        "arg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_code"],
          "properties": {
            "reason_code": {"$ref": "#/$defs/opaque"}
          }
        }
      }
    },
    "instruction": {
      "oneOf": [
        {"$ref": "#/$defs/pin_context"},
        {"$ref": "#/$defs/observe"},
        {"$ref": "#/$defs/claim"},
        {"$ref": "#/$defs/challenge"},
        {"$ref": "#/$defs/warrant"},
        {"$ref": "#/$defs/import_authority"},
        {"$ref": "#/$defs/record_action"},
        {"$ref": "#/$defs/record_outcome"},
        {"$ref": "#/$defs/close"},
        {"$ref": "#/$defs/halt"}
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "policy_sha256", "instructions"],
      "properties": {
        "schema": {"const": "humanaios.core-machine.program.v0.1"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "instructions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/instruction"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "claims", "challenges", "warrants", "authorities", "actions", "outcomes"],
      "properties": {
        "observations": {"type": "integer", "minimum": 0},
        "claims": {"type": "integer", "minimum": 0},
        "challenges": {"type": "integer", "minimum": 0},
        "warrants": {"type": "integer", "minimum": 0},
        "authorities": {"type": "integer", "minimum": 0},
        "actions": {"type": "integer", "minimum": 0},
        "outcomes": {"type": "integer", "minimum": 0}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "program_id", "repository", "subject_head_sha", "policy_sha256",
        "program_sha256", "status", "reason_codes", "counts", "bindings",
        "trust_anchor_authentication", "authority_effect", "can_authorize",
        "can_execute", "merge_authority", "authenticated", "receipt_id"
      ],
      "properties": {
        "schema": {"const": "humanaios.core-machine.receipt.v0.1"},
        "program_id": {"$ref": "#/$defs/opaque"},
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "subject_head_sha": {"$ref": "#/$defs/commit"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "program_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_chain_head": {"$ref": "#/$defs/sha256"},
        "review_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "status": {
          "enum": [
            "READY_FOR_EXTERNAL_AUTHORITY",
            "AUTHORIZATION_RECEIPT_BOUND",
            "ACTION_OBSERVED",
            "OUTCOME_OBSERVED",
            "HALTED"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaque"}
        },
        "counts": {"$ref": "#/$defs/counts"},
        "bindings": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "warrant_id", "authorization_receipt_id",
              "warrant_sha256", "review_snapshot_sha256",
              "authorization_consumption", "action_receipt_id",
              "outcome_receipt_id"
            ]
          },
          "additionalProperties": {"$ref": "#/$defs/opaque"}
        },
        "trust_anchor_authentication": {"const": "EXTERNAL_TO_VM"},
        "authority_effect": {"const": "NONE"},
        "can_authorize": {"const": false},
        "can_execute": {"const": false},
        "merge_authority": {"const": false},
        "authenticated": {"const": false},
        "receipt_id": {
          "type": "string",
          "pattern": "^HCM-[0-9a-f]{24}$"
        }
      }
    }
  }
}
