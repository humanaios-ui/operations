{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanaios.ai/schemas/intent_os_operator_check_v1.schema.json",
  "title": "INTENT-OS RNOLA Operator Check v1",
  "$comment": "HARD CONSTRAINT: This record is advisory evidence only. It cannot approve a PR, satisfy required review, sign a ruling, ratify a candidate, change a merge gate, authorize deployment, or substitute for CI, test evidence, or repository provenance. Treating an operator-check as authorization violates RNOLA semantics and INTENT-OS governance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "advisory_only",
    "can_authorize",
    "subject",
    "intent",
    "question",
    "operator_response",
    "evidence_inspected",
    "calibration",
    "authority_consequence",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "intentos/operator_check_v1"
    },
    "advisory_only": {
      "const": true,
      "$comment": "REQUIRED: This record must always be advisory only. Never change this to false."
    },
    "can_authorize": {
      "const": false,
      "$comment": "REQUIRED: This record cannot authorize any action. Never change this to true."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository", "ref", "identifier"],
      "properties": {
        "type": {
          "enum": [
            "pull_request",
            "file",
            "workflow",
            "issue",
            "decision",
            "request",
            "receipt",
            "commit"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 7,
          "pattern": "^[0-9a-f]{7,40}$",
          "$comment": "REQUIRED: Must be a commit SHA (hex string, 7–40 chars). Branch names are not acceptable refs. Use git rev-parse to get the exact SHA."
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "artifact_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "operator_response": {
      "type": "string",
      "minLength": 1
    },
    "evidence_inspected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "observation"],
        "properties": {
          "kind": {
            "enum": [
              "diff",
              "source",
              "test",
              "ci",
              "workflow",
              "receipt",
              "decision",
              "provenance",
              "other"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "(#|:)",
            "$comment": "REQUIRED: Must cite exact location in repository artifact. Must include at least one specificity marker: '#' for comments/issues or ':' for line numbers. Examples: 'PR-534#comment-123', 'tests/test_*.py:42', 'commit:abc123def456', 'workflows/ci.yml:L15'. Generic 'PR-534' alone is insufficient."
          },
          "observation": {
            "type": "string",
            "minLength": 10,
            "$comment": "REQUIRED: Describe what was actually observed at the locator, not a generic claim. Minimum 10 characters to discourage placeholder entries."
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demonstrated", "partial", "not_tested", "unknown"],
      "properties": {
        "demonstrated": {
          "$ref": "#/$defs/stringSet"
        },
        "partial": {
          "$ref": "#/$defs/stringSet"
        },
        "not_tested": {
          "$ref": "#/$defs/stringSet"
        },
        "unknown": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "authority_consequence": {
      "type": "string",
      "minLength": 1,
      "$comment": "Document what would change if the subject were merged/approved. This is NOT authorization. The operator-check cannot satisfy required review, sign a ratification, or change a merge gate."
    },
    "next_learning_object": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
