{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanaios.ai/schemas/intent_os_operator_check_v1.schema.json",
  "title": "INTENT-OS RNOLA Operator Check v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "advisory_only",
    "can_authorize",
    "subject",
    "intent",
    "question",
    "operator_response",
    "evidence_inspected",
    "calibration",
    "authority_consequence",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "intentos/operator_check_v1"
    },
    "advisory_only": {
      "const": true
    },
    "can_authorize": {
      "const": false
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository", "ref", "identifier"],
      "properties": {
        "type": {
          "enum": [
            "pull_request",
            "file",
            "workflow",
            "issue",
            "decision",
            "request",
            "receipt",
            "commit"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "artifact_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "operator_response": {
      "type": "string",
      "minLength": 1
    },
    "evidence_inspected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "observation"],
        "properties": {
          "kind": {
            "enum": [
              "diff",
              "source",
              "test",
              "ci",
              "workflow",
              "receipt",
              "decision",
              "provenance",
              "other"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demonstrated", "partial", "not_tested", "unknown"],
      "properties": {
        "demonstrated": {
          "$ref": "#/$defs/stringSet"
        },
        "partial": {
          "$ref": "#/$defs/stringSet"
        },
        "not_tested": {
          "$ref": "#/$defs/stringSet"
        },
        "unknown": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "authority_consequence": {
      "type": "string",
      "minLength": 1
    },
    "next_learning_object": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
