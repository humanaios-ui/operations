{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanaios.ai/schemas/resource_request.schema.json",
  "title": "HumanAIOS Resource Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_id", "resources", "authority", "dependencies", "evidence", "safety"],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llm_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "github_reads": {"type": "integer", "minimum": 0},
        "github_writes": {"type": "integer", "minimum": 0},
        "web_queries": {"type": "integer", "minimum": 0},
        "human_review_slots": {"type": "integer", "minimum": 0},
        "independent_review_slots": {"type": "integer", "minimum": 0},
        "cash_usd": {"type": "number", "minimum": 0}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_zone"],
      "properties": {
        "required_zone": {"type": "string", "enum": ["Z1", "Z2", "Z3"]},
        "authorization_ref": {"type": ["string", "null"]}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_floor_pass"],
      "properties": {
        "hard_floor_pass": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "external_constraint": {
      "$ref": "external_constraint.schema.json"
    }
  }
}
