    "config": {
      "opportunities": [
        {
          "title": "Microsoft for Startups — entry Startup credits",
          "url": "https://learn.microsoft.com/en-us/startups/microsoft-for-startups/getting-started-mfs",
          "opportunity_kind": "startup_credit_entry",
          "source_category": "compute_credit",
          "sponsor": "Microsoft",
          "tags": [
            "startup",
            "azure",
            "startup-credit"
          ],
          "description": "Current Microsoft for Startups entry credit path. Treat published credit amounts and eligibility as observations to re-verify, not as entitlement.",
          "observe_url": true
        },
        {
          "title": "Microsoft for Startups — progressive Startup credits",
          "url": "https://learn.microsoft.com/en-us/startups/microsoft-for-startups/overview",
          "opportunity_kind": "startup_credit_progression",
          "source_category": "compute_credit",
          "sponsor": "Microsoft",
          "tags": [
            "startup",
            "azure",
            "startup-credit",
            "progression"
          ],
          "description": "Current progression path for additional Startup credits based on verified progress, service adoption, and sustained Azure usage.",
          "observe_url": true
        },
        {
          "title": "Microsoft for Startups — Marketplace and co-sell access",
          "url": "https://learn.microsoft.com/en-us/startups/microsoft-for-startups/overview",
          "opportunity_kind": "go_to_market_access",
          "sponsor": "Microsoft",
          "tags": [
            "startup",
            "marketplace",
            "co-sell",
            "go-to-market"
          ],
          "description": "Program access path to Microsoft Marketplace and co-sell opportunities. Eligibility and activation remain downstream verification.",
          "observe_url": true
        }
      ]
    }
