{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanaios.ai/schemas/query-execution-receipt.v1.schema.json",
  "title": "HumanAIOS Query Execution Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "receipt_token",
    "authorization_id",
    "authorization_token",
    "authorization_decision_sha256",
    "query_id",
    "query_token",
    "query_plan_sha256",
    "policy_receipt_sha256",
    "registry_mine_id",
    "pathway_opportunity_id",
    "subject_ref",
    "private_subject_binding_attestation_id",
    "private_subject_binding_attested",
    "executed_operation",
    "executed_query_fields",
    "observed_origin_key",
    "execution_nonce",
    "started_at",
    "finished_at",
    "result_state",
    "observed_record_count",
    "expected_response_class",
    "zero_result_semantics",
    "match_result_semantics",
    "query_value_persistence",
    "private_query_values_exposed",
    "raw_request_exposed",
    "raw_response_exposed",
    "external_state_change",
    "consequential_actions_permitted",
    "claim_submission_permitted",
    "prohibited_action_executed",
    "authorization_consumed",
    "authorization_consumption_ordinal",
    "consumption_key",
    "consequence_ceiling",
    "evidence_effect",
    "authority_effect",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "humanaios.query-execution-receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^QRC-[A-F0-9]{16}$"
    },
    "receipt_token": {
      "type": "string",
      "pattern": "^urn:humanaios:query-execution-receipt:QRC-[A-F0-9]{16}$"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^OAG-[A-F0-9]{16}$"
    },
    "authorization_token": {
      "type": "string",
      "pattern": "^urn:humanaios:observation-authorization:OAG-[A-F0-9]{16}$"
    },
    "authorization_decision_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "query_id": {
      "type": "string",
      "pattern": "^RQY-[A-F0-9]{16}$"
    },
    "query_token": {
      "type": "string",
      "pattern": "^urn:humanaios:registry-query:RQY-[A-F0-9]{16}$"
    },
    "query_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registry_mine_id": {
      "type": "string",
      "pattern": "^MINE-[A-F0-9]{16}$"
    },
    "pathway_opportunity_id": {
      "type": "string",
      "pattern": "^OPP-[A-F0-9]{16}$"
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^SUBJ-[A-F0-9]{16}$"
    },
    "private_subject_binding_attestation_id": {
      "type": "string",
      "pattern": "^PSB-[A-F0-9]{16}$"
    },
    "private_subject_binding_attested": {
      "const": true
    },
    "executed_operation": {
      "const": "OBSERVE_REGISTRY_QUERY_RESULTS"
    },
    "executed_query_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "owner_name",
          "business_name",
          "last_known_location"
        ]
      }
    },
    "observed_origin_key": {
      "type": "string",
      "minLength": 1
    },
    "execution_nonce": {
      "type": "string",
      "pattern": "^EXE-[A-F0-9]{16}$"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "result_state": {
      "enum": [
        "ZERO_MATCHES_OBSERVED",
        "MATCHES_OBSERVED",
        "OBSERVATION_FAILED"
      ]
    },
    "observed_record_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "expected_response_class": {
      "const": "ZERO_OR_MORE_CANDIDATE_RECORDS"
    },
    "zero_result_semantics": {
      "const": "NO_MATCH_OBSERVED_NOT_NO_ENTITLEMENT"
    },
    "match_result_semantics": {
      "const": "CANDIDATE_RECORD_NOT_OWNERSHIP"
    },
    "query_value_persistence": {
      "const": "PRIVATE_RUNTIME_ONLY"
    },
    "private_query_values_exposed": {
      "const": false
    },
    "raw_request_exposed": {
      "const": false
    },
    "raw_response_exposed": {
      "const": false
    },
    "external_state_change": {
      "const": false
    },
    "consequential_actions_permitted": {
      "const": false
    },
    "claim_submission_permitted": {
      "const": false
    },
    "prohibited_action_executed": {
      "const": false
    },
    "authorization_consumed": {
      "const": true
    },
    "authorization_consumption_ordinal": {
      "const": 1
    },
    "consumption_key": {
      "type": "string",
      "pattern": "^CON-[A-F0-9]{16}$"
    },
    "consequence_ceiling": {
      "const": "EVIDENCE_ONLY"
    },
    "evidence_effect": {
      "const": "OBSERVATION_RECEIPT_ONLY"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result_state": {
            "const": "ZERO_MATCHES_OBSERVED"
          }
        }
      },
      "then": {
        "properties": {
          "observed_record_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result_state": {
            "const": "MATCHES_OBSERVED"
          }
        }
      },
      "then": {
        "properties": {
          "observed_record_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result_state": {
            "const": "OBSERVATION_FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "observed_record_count": {
            "const": null
          }
        }
      }
    }
  ]
}
