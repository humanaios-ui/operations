{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanaios.ai/schemas/opportunity-claim.v1.schema.json",
  "title": "HumanAIOS Opportunity Claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "claim_token",
    "claim_type",
    "opportunity_id",
    "opportunity_token",
    "claim_text",
    "asserted_at",
    "overall_state",
    "facets",
    "evidence",
    "falsifiers",
    "warrant_state",
    "authorization_state",
    "actionability_state",
    "authority_effect"
  ],
  "properties": {
    "schema": {"const": "humanaios.opportunity-claim.v1"},
    "claim_id": {"type": "string", "pattern": "^CLM-[A-F0-9]{16}$"},
    "claim_token": {"type": "string", "pattern": "^urn:humanaios:opportunity-claim:CLM-[A-F0-9]{16}$"},
    "claim_type": {"const": "RESOURCE_OPPORTUNITY"},
    "opportunity_id": {"type": "string", "pattern": "^OPP-[A-F0-9]{16}$"},
    "opportunity_token": {"type": "string", "pattern": "^urn:humanaios:resource-opportunity:OPP-[A-F0-9]{16}$"},
    "claim_text": {"type": "string", "minLength": 1},
    "asserted_at": {"type": "string", "minLength": 1},
    "mine_id": {"type": "string"},
    "mine_name": {"type": "string"},
    "canonical_url": {"type": "string"},
    "opportunity_kind": {"type": "string"},
    "overall_state": {
      "enum": ["UNVERIFIED", "OBSERVED", "SUPPORTED", "CONTESTED", "RETIRED", "FALSIFIED"]
    },
    "facets": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "statement", "evidence_ids", "updated_at"],
        "properties": {
          "name": {"enum": ["EXISTENCE", "CURRENTNESS", "TERMS", "ELIGIBILITY", "ATTAINABILITY"]},
          "state": {"enum": ["UNKNOWN", "UNASSESSED", "SUPPORTED", "CONTRADICTED", "FALSIFIED", "NOT_APPLICABLE"]},
          "statement": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "updated_at": {"type": ["string", "null"]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "relation", "facet", "url", "kind", "observed_at", "claim"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EVD-[A-F0-9]{16}$"},
          "relation": {"enum": ["SUPPORTS", "CONTRADICTS", "FALSIFIES", "CONTEXT"]},
          "facet": {"enum": ["EXISTENCE", "CURRENTNESS", "TERMS", "ELIGIBILITY", "ATTAINABILITY"]},
          "url": {"type": "string"},
          "kind": {"type": "string"},
          "observed_at": {"type": "string"},
          "claim": {"type": "string"}
        }
      }
    },
    "falsifiers": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["falsifier_id", "facet", "condition", "observation_surface", "effect", "state", "evidence_ids", "evaluated_at"],
        "properties": {
          "falsifier_id": {"type": "string", "pattern": "^FAL-[A-F0-9]{16}$"},
          "facet": {"enum": ["EXISTENCE", "CURRENTNESS", "TERMS", "ELIGIBILITY", "ATTAINABILITY"]},
          "condition": {"type": "string", "minLength": 1},
          "observation_surface": {"type": "string", "minLength": 1},
          "effect": {"const": "FALSIFY_FACET"},
          "state": {"enum": ["UNTESTED", "NOT_OBSERVED", "OBSERVED", "INCONCLUSIVE"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "evaluated_at": {"type": ["string", "null"]}
        }
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "required_resources": {"type": "array", "items": {"type": "string"}},
    "warrant_state": {"enum": ["NOT_EVALUATED", "INSUFFICIENT", "SUPPORTED", "REJECTED"]},
    "authorization_state": {"enum": ["NOT_REQUESTED", "PENDING", "AUTHORIZED", "DENIED"]},
    "actionability_state": {"enum": ["NOT_ACTIONABLE", "VERIFY", "READY_FOR_AUTHORIZATION", "AUTHORIZED"]},
    "authority_effect": {"const": "NONE"}
  }
}
