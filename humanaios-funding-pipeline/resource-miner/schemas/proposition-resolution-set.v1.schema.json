{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanaios.ai/schemas/proposition-resolution-set.v1.schema.json",
  "title": "HumanAIOS Proposition Resolution Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resolution_set_id",
    "resolution_token",
    "resolution_key",
    "subject_key",
    "proposition_type",
    "predicate",
    "state",
    "member_proposition_ids",
    "member_opportunity_ids",
    "source_mine_ids",
    "distinct_source_count",
    "object_variants",
    "canonical_object_value",
    "relations",
    "unresolved_reasons",
    "observed_from",
    "observed_through",
    "truth_state",
    "eligibility_state",
    "warrant_state",
    "authorization_state",
    "authority_effect"
  ],
  "properties": {
    "schema": {
      "const": "humanaios.proposition-resolution-set.v1"
    },
    "resolution_set_id": {
      "type": "string",
      "pattern": "^PRS-[A-F0-9]{16}$"
    },
    "resolution_token": {
      "type": "string",
      "pattern": "^urn:humanaios:proposition-resolution:PRS-[A-F0-9]{16}$"
    },
    "resolution_key": {
      "type": "string",
      "minLength": 1
    },
    "subject_key": {
      "type": "string",
      "minLength": 1
    },
    "proposition_type": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "SINGLE_SOURCE",
        "CORROBORATED",
        "CONTESTED",
        "QUALIFIED",
        "SUPERSEDED",
        "UNRESOLVED"
      ]
    },
    "member_proposition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PRP-[A-F0-9]{16}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "member_opportunity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OPP-[A-F0-9]{16}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_mine_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "distinct_source_count": {
      "type": "integer",
      "minimum": 0
    },
    "object_variants": {
      "type": "array",
      "minItems": 1
    },
    "canonical_object_value": {},
    "relations": {
      "type": "array",
      "items": {
        "$ref": "proposition-relation.v1.schema.json"
      }
    },
    "unresolved_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_from": {
      "type": "string"
    },
    "observed_through": {
      "type": "string"
    },
    "truth_state": {
      "const": "NOT_DETERMINED"
    },
    "eligibility_state": {
      "const": "NOT_EVALUATED"
    },
    "warrant_state": {
      "const": "NOT_EVALUATED"
    },
    "authorization_state": {
      "const": "NOT_REQUESTED"
    },
    "authority_effect": {
      "const": "NONE"
    }
  }
}
