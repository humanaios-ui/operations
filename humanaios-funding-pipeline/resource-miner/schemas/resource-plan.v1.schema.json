{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanaios.ai/schemas/resource-plan.v1.schema.json",
  "title": "HumanAIOS Resource Plan v1 (proposed combination contract)",
  "description": "Structural contract. planning.validate_resource_plan additionally enforces global uniqueness and reference integrity. No authorization is conferred.",
  "type": "object",
  "required": ["schema", "plan_id", "resource_requirements"],
  "properties": {
    "schema": {"const": "humanaios.resource-plan.v1"},
    "plan_id": {"type": "string", "pattern": "\\S"},
    "authority_effect": {"const": "NONE"},
    "needs": {"type": "array", "items": {"$ref": "#/$defs/need"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "work_packages": {"type": "array", "items": {"$ref": "#/$defs/work"}},
    "controlled_resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "resource_requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "substitution_assessments": {"type": "array", "items": {"$ref": "#/$defs/assessment"}}
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"},
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "node": {"type": "object", "properties": {"authority_effect": {"const": "NONE"}}},
    "need": {
      "allOf": [{"$ref": "#/$defs/node"}], "required": ["need_id"],
      "properties": {"need_id": {"$ref": "#/$defs/id"}}
    },
    "capability": {
      "allOf": [{"$ref": "#/$defs/node"}], "required": ["capability_id"],
      "properties": {"capability_id": {"$ref": "#/$defs/id"}, "satisfies_need_ids": {"$ref": "#/$defs/refs"}}
    },
    "work": {
      "allOf": [{"$ref": "#/$defs/node"}], "required": ["work_package_id"],
      "properties": {"work_package_id": {"$ref": "#/$defs/id"}, "enables_capability_ids": {"$ref": "#/$defs/refs"}}
    },
    "resource": {
      "allOf": [{"$ref": "#/$defs/node"}], "required": ["resource_id"],
      "properties": {"resource_id": {"$ref": "#/$defs/id"}}
    },
    "component": {
      "type": "object", "required": ["component_id"], "additionalProperties": false,
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "label": {"type": "string"},
        "authority_effect": {"const": "NONE"}
      }
    },
    "requirement": {
      "allOf": [
        {"$ref": "#/$defs/node"},
        {
          "if": {"required": ["combination_mode"], "properties": {"combination_mode": {"const": "ALL_REQUIRED"}}},
          "then": {"required": ["required_components"]},
          "else": {"not": {"required": ["required_components"]}}
        }
      ],
      "required": ["requirement_id", "resource_types", "resolution_mode"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/id"},
        "resource_types": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}},
        "work_package_ids": {"$ref": "#/$defs/refs"},
        "capability_ids": {"$ref": "#/$defs/refs"},
        "activation_state": {"enum": ["ACTIVE", "CONDITIONAL", "INACTIVE"], "default": "ACTIVE"},
        "resolution_mode": {"enum": ["COMPOSE_INTERNAL", "ACQUIRE_EXTERNAL", "HYBRID"]},
        "mine_external": {"type": "boolean", "default": false},
        "combination_mode": {"enum": ["ALTERNATIVES", "ALL_REQUIRED"], "default": "ALTERNATIVES"},
        "required_components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}}
      }
    },
    "assessment": {
      "allOf": [{"$ref": "#/$defs/node"}],
      "required": ["requirement_id", "controlled_resource_id", "status"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/id"},
        "controlled_resource_id": {"$ref": "#/$defs/id"},
        "component_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["ADEQUATE", "PARTIAL", "INADEQUATE", "UNKNOWN"]}
      }
    }
  }
}
