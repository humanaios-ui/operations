# Platform Monitor API Credentials
# Copy this to .env and fill in your real credentials
# NEVER commit .env to git

# Twitter/X API
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=HumanAIOS-TopicMonitor/1.0

# HackerNews API (public, no auth required)
HACKERNEWS_API_URL=https://hacker-news.firebaseio.com/v0

# LessWrong API
LESSWRONG_API_URL=https://www.lesswrong.com/api/graphql
LESSWRONG_API_KEY=your_lesswrong_api_key_here

# Discord (for community servers)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_IDS=guild_id_1,guild_id_2

# GitHub Discussions (part of public discussions)
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=humanaios-ui
GITHUB_REPO=lasting-light-ai

# Signal Processing
SIGNAL_MIN_CONFIDENCE=0.65
SIGNAL_TRENDING_THRESHOLD=1.2
SIGNAL_ARCHIVE_DAYS=90

# Sentiment Analysis (optional)
OPENAI_API_KEY=your_openai_key_for_sentiment_analysis

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/platform-monitor.log

# Webhook (for manual trigger)
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_URL=https://your-domain.com/webhooks/monitor
