{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanaios:resource-system:resource_card:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "tab": {
      "enum": [
        "RESOURCES"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "value_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "activity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "resource_id",
    "tab",
    "source_url",
    "value_id",
    "activity_ids"
  ],
  "additionalProperties": false
}
