{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanaios:resource-system:claim:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "predicate": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "value": {
      "type": "boolean"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "predicate",
    "value",
    "evidence_id"
  ],
  "additionalProperties": false
}
