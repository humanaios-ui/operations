{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanaios:resource-system:trust_rule:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "authoritative": {
      "type": "boolean"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "verified_on": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "predicates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "resource_id",
    "authoritative",
    "source_url",
    "verified_on",
    "valid_until",
    "predicates"
  ],
  "additionalProperties": false
}
