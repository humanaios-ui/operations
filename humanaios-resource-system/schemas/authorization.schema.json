{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanaios:resource-system:authorization:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "purpose": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "recipient": {
      "type": "string",
      "format": "uri"
    },
    "operation": {
      "enum": [
        "DISCLOSE",
        "ARTIFACT"
      ]
    },
    "state": {
      "enum": [
        "GRANTED",
        "REVOKED"
      ]
    },
    "human_authorized": {
      "type": "boolean"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "id",
    "resource_id",
    "purpose",
    "recipient",
    "operation",
    "state",
    "human_authorized",
    "expires_at"
  ],
  "additionalProperties": false
}
