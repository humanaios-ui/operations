#!/usr/bin/env python3
"""
acat-score CLI wrapper for ACAT assessment scoring.

Callable as: acat-score assess --session-id <id> --ai-id <practice> ...
"""

import sys
from pathlib import Path

# Add operations directory to path so acat module can be imported
ops_dir = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ops_dir))

from acat.cli.commands import main

if __name__ == "__main__":
    main()
