{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanaios.ai/schemas/oracle_graph_delta_v1.schema.json",
  "title": "HumanAIOS Oracle Graph Delta v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delta_id",
    "oracle_id",
    "recorded_at",
    "operations",
    "source_observation_ids",
    "advisory_only",
    "can_authorize",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "delta_id": {
      "type": "string",
      "minLength": 1
    },
    "oracle_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_observation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "subject_id",
          "as_of"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "ADD",
              "SUPERSEDE",
              "RETRACT",
              "CONTRADICT"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "object_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "payload": {
            "type": [
              "object",
              "null"
            ]
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_observation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "candidate_change": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "coordinator_input_only",
        "authority_effect"
      ],
      "properties": {
        "coordinator_input_only": {
          "const": true
        },
        "authority_effect": {
          "const": "NONE"
        },
        "target_repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_change_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "objective_issue_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "evidence_assertion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "advisory_only": {
          "const": true
        },
        "can_authorize": {
          "const": false
        }
      }
    },
    "advisory_only": {
      "const": true
    },
    "can_authorize": {
      "const": false
    },
    "authority_effect": {
      "const": "NONE"
    }
  }
}
