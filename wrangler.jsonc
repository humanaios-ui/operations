// wrangler.jsonc — the Intent-OS board as a Cloudflare Worker, login-gated (board/worker.js).
// Deployed by Cloudflare Workers Builds from this repository (Workers & Pages → connect humanaios-ui/operations,
// root directory "/", no build command, deploy command `npx wrangler deploy`). Nothing runs from a laptop.
// Serves ui/ — the board, the test dashboard, the Z2 reviewer — and only after board/worker.js has verified a
// Cloudflare Access login; run_worker_first makes that check precede the asset router on every path.
// ACCESS_TEAM_DOMAIN and ACCESS_AUD are set in the dashboard (Settings → Variables), kept by keep_vars; until
// they are set the Worker answers 401 to everything but /healthz (d17 holds until d31 rules).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intent-os-board",
  "main": "board/worker.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
