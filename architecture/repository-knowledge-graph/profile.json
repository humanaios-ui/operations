      "adapter": "artifact_inventory",
      "declared_status": "HISTORICAL_SNAPSHOT",
      "authority_effect": "NONE"
    }
  ],
  "canonical_artifacts": [
    {
      "path": "SEED.md",
      "role": "identity_anchor",
      "authority_class": "CLASS_0",
      "note": "Repository-declared identity anchor; graph does not promote its claims."
    },
    {
