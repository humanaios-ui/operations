{
  "version": "0.1.0",
  "graph_id": "humanaios-operations-repository-knowledge-graph",
  "repository": "humanaios-ui/operations",
  "status": "DERIVED_NON_CANONICAL",
  "purpose": "Deterministic, provenance-bearing read model over the operations repository and its existing named graphs.",
  "invariants": [
    "GRAPH_IS_NOT_AUTHORITY",
    "REFERENCE_IS_NOT_EVIDENCE",
    "CLAIM_IS_NOT_IMPLEMENTATION",
    "IMPLEMENTATION_IS_NOT_TEST",
    "TEST_IS_NOT_OBSERVED_OUTCOME",
    "TEST_ASSOCIATION_IS_NOT_TEST_PASS",
    "INFERENCE_IS_NOT_OBSERVATION",
    "INFERENCE_IS_NOT_WARRANT",
    "INFERENCE_IS_NOT_AUTHORIZATION",
    "INFERENCE_MUST_BE_RECONSTRUCTABLE_AND_FALSIFIABLE",
    "MODEL_AGREEMENT_IS_NOT_PROOF",
    "PARTICIPATION_IS_NOT_AUTHORITY",
    "CALIBRATION_IS_NOT_WARRANT",
    "WARRANT_IS_NOT_AUTHORIZATION",
    "AUTHORIZATION_IS_NOT_EXECUTION",
    "MULTIPLE_PROJECTIONS_ARE_NOT_MULTIPLE_TRUTHS",
    "NO_AUTONOMOUS_GRAPH_MUTATION",
    "NO_AUTONOMOUS_SELF_AUTHORIZATION"
  ],
  "exclude_paths": [
    ".git/",
    "node_modules/",
    "outputs/",
    "reports/",
    ".pytest_cache/",
    "__pycache__/"
  ],
  "content_scan_exclusions": [
    ".env",
    ".env.*",
    "*Resume*",
    "*resume*",
    "*.db",
    "*.zip",
    "*.docx",
    "*.jpg",
    "*.jpeg",
    "*.png",
    "*.glb"
  ],
  "source_graphs": [
