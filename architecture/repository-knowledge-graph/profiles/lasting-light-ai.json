  "inference": {
    "enabled": true,
    "mode": "DETERMINISTIC_BOUNDED",
    "epistemic_state": "MODEL_INFERRED",
    "recursive": false,
    "max_assertions": 3000,
    "forbidden_conclusion_relations": [
      "AUTHORIZES",
      "CAUSES",
      "CLAIM_PROVEN",
      "ELIGIBLE",
      "ENFORCES",
      "EXECUTED",
      "GRANTS_AUTHORITY",
      "HAS_CAPABILITY",
      "IS_CAPABLE",
      "PERMITS",
      "PROVES",
      "TESTS_PASS"
    ],
    "rules": [
      {
        "id": "RGM-INF-LOCAL-DEPENDENCY-01",
        "kind": "two_edge_join",
        "description": "A local artifact that imports another local artifact may depend on a second local artifact imported by that intermediate artifact.",
        "left_relation": "IMPORTS",
        "right_relation": "IMPORTS",
        "right_direction": "out",
        "subject_types": ["artifact"],
        "intermediate_types": ["artifact"],
        "object_types": ["artifact"],
        "exclude_if_direct_relations": ["IMPORTS"],
        "conclusion_relation": "MAY_DEPEND_ON_TRANSITIVELY",
        "confidence": 0.8,
        "independence": "NOT_APPLICABLE",
        "max_assertions": 2000,
        "human_review_required": true,
        "assumptions": [
          "Static local import resolution approximates a reachable dependency path."
        ],
        "not_evidence_of": [
          "runtime execution",
          "causality",
          "capability",
          "authority"
        ],
        "falsifier": "Remove or disprove either local import premise, or show that runtime conditions make the inferred path unreachable."
      },
      {
        "id": "RGM-INF-WORKFLOW-TEST-PATH-01",
        "kind": "two_edge_join",
        "description": "A workflow job that invokes a test artifact may exercise an implementation associated with that test artifact.",
        "left_relation": "INVOKES",
        "right_relation": "TESTS",
        "right_direction": "out",
        "subject_types": ["workflow_job"],
        "intermediate_types": ["artifact"],
        "object_types": ["artifact"],
        "conclusion_relation": "MAY_EXERCISE",
        "confidence": 0.75,
        "independence": "NOT_ESTABLISHED",
        "max_assertions": 1000,
        "human_review_required": true,
        "assumptions": [
          "The invoked test artifact follows the statically observed TESTS association."
        ],
        "not_evidence_of": [
          "workflow success",
          "test pass",
          "claim proof",
          "runtime coverage"
        ],
        "falsifier": "Show that the workflow does not execute the test path or that the test does not reach the associated implementation."
      }
    ]
  },
  "views": [
    {
      "id": "repository",
      "title": "Repository topology",
      "description": "Artifacts, directories, code, tests, workflows, schemas, references, and static dependencies.",
      "node_types": [
        "repository",
        "directory",
        "artifact",
        "section",
        "workflow",
        "workflow_job",
        "schema",
        "module",
        "action_dependency"
      ]
    },
    {
      "id": "research",
      "title": "Research structure",
      "description": "Curated research claims, method, protocol, evidence, validation, governance, and intent concepts.",
      "id_prefixes": ["concept:"]
    },
    {
      "id": "inference",
      "title": "Bounded inference",
      "description": "Deterministic MODEL_INFERRED assertions with premises, falsifiers, and no authority effect.",
      "node_types": ["inference_assertion"],
      "include_incident_edges": true
    },
    {
      "id": "risk",
      "title": "Risk and unresolved state",
      "description": "Parse failures, unresolved references, and GitHub items whose live state was not ingested.",
      "node_types": [
        "parse_failure",
        "unresolved_reference",
        "github_item"
      ],
      "include_incident_edges": true
    },
    {
      "id": "provenance",
      "title": "Provenance",
      "description": "Citations, declarations, references, repository identities, and derivation paths.",
      "relations": [
        "CITES",
        "DECLARES",
        "REFERENCES",
        "REFERENCES_GITHUB_ITEM",
        "REFERENCES_WORK_ITEM"
      ]
    }
  ]
}
