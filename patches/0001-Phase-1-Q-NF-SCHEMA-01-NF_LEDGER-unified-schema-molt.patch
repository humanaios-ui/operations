+def test_falsifier_q_nf_schema_01():
+    """
+    Test Falsifier for Q-NF-SCHEMA-01:
+    "if after the adapter molt_cycle --read-only --nf still reports nf_resolved: 0
+     against a ledger with >=1 RESOLVE row -> FAIL"
+
+    We'll create a synthetic ledger with RESOLVE entries and verify the adapter
+    correctly counts them.
+    """
+    # Create a ledger with PIN and RESOLVE entries
+    ledger_data = [
+        {"type": "PIN", "target": "specimen-01", "predictor": "SI", "p": 0.7, "at": "2026-09-10"},
+        {"type": "RESOLVE", "target": "specimen-01", "outcome": "YES", "at": "2026-09-12"},
+        {"type": "PIN", "target": "specimen-02", "predictor": "SI", "p": 0.3, "at": "2026-09-10"},
+        {"type": "RESOLVE", "target": "specimen-02", "outcome": "NO", "at": "2026-09-13"},
+    ]
+
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.jsonl', delete=False) as f:
+        for entry in ledger_data:
+            f.write(json.dumps(entry) + '\n')
+        temp_path = f.name
+
+    try:
+        # Simulate the molt_cycle --read-only --nf command
+        mc = MoltCycle(nf_ledger_path=temp_path)
+        mc.read_nf_ledger()
