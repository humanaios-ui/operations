+"""
+test_nf_schema_integration.py — Q-NF-SCHEMA-01 Integration Tests
+
+Tests PIN/RESOLVE joining, Brier calculation, and molt_cycle integration
+with NF_LEDGER.jsonl per NF_LEDGER_SCHEMA_v1.md specification.
+"""
+
+import json
+import tempfile
+import sys
+import os
+
+# Add parent to path
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from molt_cycle import MoltCycle
+
+
+def test_read_nf_ledger_mesh_pins():
+    """Test reading existing NF_LEDGER.jsonl with mesh pins."""
+    mc = MoltCycle(nf_ledger_path="ledgers/NF_LEDGER.jsonl")
+    result = mc.read_nf_ledger()
+
+    assert result['status'] == 'READ_COMPLETE'
+    assert result['ledger_entries'] == 165
+    assert result['pin_targets'] > 0
+    print(f"✓ Read NF_LEDGER: {result['ledger_entries']} entries, {result['pin_targets']} PIN targets")
+
+
+def test_join_pin_resolve_pairs_with_synthetic_data():
+    """Test PIN/RESOLVE joining with synthetic test data."""
+    # Create temporary ledger with PIN and RESOLVE entries
+    ledger_data = [
+        {
+            "at": "2026-09-10",
+            "type": "PIN",
+            "target": "T-test-01",
+            "predictor": "Z1",
+            "p": 0.65,
+            "claim": "Test forecast"
+        },
+        {
+            "at": "2026-09-15",
+            "type": "RESOLVE",
+            "target": "T-test-01",
+            "outcome": "YES",  # Outcome: prediction held
+            "source": "manual_verify"
+        },
+        {
+            "at": "2026-09-10",
+            "type": "PIN",
+            "target": "T-test-02",
+            "predictor": "Z1",
+            "p": 0.40,
+            "claim": "Another forecast"
+        },
+        {
+            "at": "2026-09-14",
+            "type": "RESOLVE",
+            "target": "T-test-02",
+            "outcome": "NO",  # Outcome: prediction didn't hold
+            "source": "manual_verify"
+        }
+    ]
+
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.jsonl', delete=False) as f:
+        for entry in ledger_data:
+            f.write(json.dumps(entry) + '\n')
+        temp_path = f.name
+
+    try:
+        mc = MoltCycle(nf_ledger_path=temp_path)
+        mc.read_nf_ledger()
+
+        pairs = mc.join_pin_resolve_pairs()
+        assert len(pairs) == 2, f"Expected 2 PIN/RESOLVE pairs, got {len(pairs)}"
+
+        # Verify first pair (YES outcome)
+        pair1 = next((p for p in pairs if p['target'] == 'T-test-01'), None)
+        assert pair1 is not None
+        assert pair1['pin_p'] == 0.65
+        assert pair1['resolve_outcome'] == 'YES'
+
+        # Verify second pair (NO outcome)
+        pair2 = next((p for p in pairs if p['target'] == 'T-test-02'), None)
+        assert pair2 is not None
+        assert pair2['pin_p'] == 0.40
+        assert pair2['resolve_outcome'] == 'NO'
+
+        print(f"✓ PIN/RESOLVE joining: {len(pairs)} pairs created correctly")
+
+    finally:
+        os.unlink(temp_path)
+
+
+def test_brier_calculation():
+    """Test Brier score calculation."""
+    # Create test data
+    ledger_data = [
+        # Test case 1: Perfect prediction (p=1.0, outcome=YES)
+        {
+            "type": "PIN",
+            "target": "T-perfect",
+            "predictor": "Z1",
+            "p": 1.0,
+            "at": "2026-09-10"
+        },
+        {
+            "type": "RESOLVE",
+            "target": "T-perfect",
+            "outcome": "YES",
+            "at": "2026-09-15"
+        },
+        # Test case 2: Bad prediction (p=0.0, outcome=YES)
+        {
+            "type": "PIN",
+            "target": "T-bad",
+            "predictor": "Z1",
+            "p": 0.0,
+            "at": "2026-09-10"
+        },
+        {
+            "type": "RESOLVE",
+            "target": "T-bad",
+            "outcome": "YES",
+            "at": "2026-09-15"
+        },
+        # Test case 3: Uncertain prediction (p=0.5, outcome=YES)
+        {
+            "type": "PIN",
+            "target": "T-uncertain",
+            "predictor": "Z1",
+            "p": 0.5,
+            "at": "2026-09-10"
+        },
+        {
+            "type": "RESOLVE",
+            "target": "T-uncertain",
+            "outcome": "YES",
+            "at": "2026-09-15"
+        }
+    ]
+
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.jsonl', delete=False) as f:
+        for entry in ledger_data:
+            f.write(json.dumps(entry) + '\n')
+        temp_path = f.name
+
+    try:
+        mc = MoltCycle(nf_ledger_path=temp_path)
+        mc.read_nf_ledger()
+        pairs = mc.join_pin_resolve_pairs()
+        brier = mc.calculate_brier_scores(pairs)
+
+        # Expected Brier scores:
+        # T-perfect: (1.0 - 1)^2 = 0.0
+        # T-bad: (0.0 - 1)^2 = 1.0
+        # T-uncertain: (0.5 - 1)^2 = 0.25
+        # Overall Brier = (0.0 + 1.0 + 0.25) / 3 = 0.4167
+
+        expected_brier = (0.0 + 1.0 + 0.25) / 3
+        assert abs(brier['brier_overall'] - expected_brier) < 0.01, \
+            f"Expected Brier ~{expected_brier:.4f}, got {brier['brier_overall']:.4f}"
+
+        print(f"✓ Brier calculation correct: {brier['brier_overall']:.4f}")
+
+    finally:
+        os.unlink(temp_path)
+
+
