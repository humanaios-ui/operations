         }
 
+    def _validate_anti_cascade_rules(self, candidate: Dict[str, Any]) -> List[str]:
+        """Check all 5 anti-cascade rules for a molt candidate.
+
+        Returns list of violated rule descriptions; empty list if all rules pass.
+
+        Rule 1: One open molt per constant (no new candidate inside window W)
+        Rule 2: No self-reference (candidate not from events in its own window)
+        Rule 3: K=3 system-wide limit on open molts
+        Rule 4: Freeze after 2 reverts (Z2 Tier 2 override required)
+        Rule 5: Ranking by Priority Queue score (no bypass)
+        """
+        violations = []
+        constant_name = candidate.get('name')
+
+        # Rule 1: One open molt per constant (no new candidate inside window W)
+        if constant_name in self.state.constants_in_molt:
+            existing_molt = self.state.constants_in_molt[constant_name]
+            violations.append(
+                f"Rule 1 VIOLATED: Constant '{constant_name}' already has open molt "
+                f"(id={existing_molt}). No new candidate allowed inside window W."
+            )
+
+        # Rule 2: No self-reference (candidate not generated from events in its own window)
+        if self._is_self_referential(constant_name, candidate):
+            violations.append(
+                f"Rule 2 VIOLATED: Candidate for '{constant_name}' generated from events "
+                f"within its own measurement window. Self-referential molt blocked."
+            )
+
+        # Rule 3: K=3 system-wide limit on open molts
+        if self.state.open_molts_count >= self.k_limit:
+            violations.append(
+                f"Rule 3 VIOLATED: System open molts ({self.state.open_molts_count}) "
+                f"at or above limit K={self.k_limit}. No new molts allowed until one resolves."
+            )
+
+        # Rule 4: Freeze after 2 reverts (Z2 Tier 2 override required)
+        if constant_name in self.state.constants_frozen:
+            violations.append(
+                f"Rule 4 VIOLATED: Constant '{constant_name}' is frozen after 2+ consecutive reverts. "
+                f"Z2 Tier-2 override signature required to reopen."
+            )
+
+        # Rule 5: Priority Queue ranking (no bypass)
+        pq_rank = candidate.get('priority_queue_rank')
+        pq_score = candidate.get('priority_queue_score')
+        if pq_rank is None or pq_rank < 0:
+            violations.append(
+                f"Rule 5 VIOLATED: Candidate for '{constant_name}' not found in Priority Queue "
+                f"(rank={pq_rank}). Molt candidates must be ranked; no bypass allowed."
+            )
+
+        return violations
+
+    def _is_self_referential(self, constant_name: str, candidate: Dict[str, Any]) -> bool:
+        """Check if candidate was generated from events in its own measurement window.
+
+        A molt is self-referential if it was proposed based on events that occurred
+        within the window it is meant to measure.
+        """
+        candidate_window_days = candidate.get('measurement_window_days', 30)
+        candidate_proposed_at = candidate.get('proposed_at')
+
+        if not candidate_proposed_at:
+            # No proposal timestamp; cannot determine self-reference
+            return False
+
+        try:
+            # Parse ISO format datetime
+            if isinstance(candidate_proposed_at, str):
+                proposed_dt = datetime.fromisoformat(
+                    candidate_proposed_at.replace('Z', '+00:00')
+                )
+            else:
+                proposed_dt = candidate_proposed_at
+        except (ValueError, AttributeError, TypeError):
+            return False
+
+        # Window lookback period
+        window_start = proposed_dt - timedelta(days=candidate_window_days)
+
+        # Check if any events generating this candidate fall within the window
+        for entry in self.nf_entries:
+            entry_type = entry.get('type')
+            if entry_type not in ['VERDICT', 'MEASURE', 'CYCLE']:
+                continue
+
+            try:
+                entry_at_str = entry.get('at')
+                if isinstance(entry_at_str, str):
+                    entry_at = datetime.fromisoformat(entry_at_str.replace('Z', '+00:00'))
+                else:
+                    entry_at = entry_at_str
+
+                # Check if event is within the window
+                if window_start <= entry_at <= proposed_dt:
+                    # Event is within window; check if it relates to this constant
+                    entry_target = entry.get('target', '')
+                    if constant_name in entry_target or constant_name == entry.get('constant'):
+                        # Event relates to constant within its own window
+                        return True
+            except (ValueError, TypeError, AttributeError):
+                continue
+
+        return False
+
 
