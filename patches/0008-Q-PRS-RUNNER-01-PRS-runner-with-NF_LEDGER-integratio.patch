+@dataclass
+class NFLedgerEntry:
+    """NF_LEDGER entry: prediction registration (PIN) or resolution (RESOLVE)."""
+    entry_id: str              # PIN-XXXX or RESOLVE-XXXX
+    hypothesis_id: str
+    entry_type: str             # PIN, RESOLVE
+    metric: str
+    prediction_value: Optional[float] = None  # For PIN: predicted threshold
+    prediction_window_days: Optional[int] = None
+    metric_actual: Optional[float] = None  # For RESOLVE: actual outcome
+    brier_score: Optional[float] = None     # (predicted - actual)^2, normalized
+    timestamp: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())
+    prior_hash: Optional[str] = None        # Hash chain anchor
+    hash: Optional[str] = None              # This entry's hash
+    ratification_hash: Optional[str] = None # Z2 signature (for RESOLVE)
+    z2_ratified_at: Optional[str] = None
+
+    def compute_hash(self) -> str:
+        """Compute SHA256 hash of this entry (excluding the hash field itself)."""
+        data_to_hash = {
+            "entry_id": self.entry_id,
+            "hypothesis_id": self.hypothesis_id,
+            "entry_type": self.entry_type,
+            "metric": self.metric,
+            "prediction_value": self.prediction_value,
+            "prediction_window_days": self.prediction_window_days,
+            "metric_actual": self.metric_actual,
+            "brier_score": self.brier_score,
+            "timestamp": self.timestamp,
+            "prior_hash": self.prior_hash,
+        }
+        return hashlib.sha256(json.dumps(data_to_hash, sort_keys=True, default=str).encode()).hexdigest()
 
 
