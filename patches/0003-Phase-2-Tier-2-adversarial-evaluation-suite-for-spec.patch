+#!/usr/bin/env python3
+"""
+test_adv_eval_specimen_intake_tier2.py — Tier-2 Adversarial Evaluation Suite
+
+Specimen-intake predictions under attack:
+  Attack 1: Forged receipt hash (hash doesn't match content)
+  Attack 2: Out-of-window resolve (resolution outside measurement window)
+  Attack 3: Replayed receipt (same receipt_hash submitted twice)
+  Attack 4: Pre-disclosure prediction (CredPolicy predicted_choice disclosed before registered_at)
+
+These are mechanical catches (code emits ATTACK events; no discretion).
+Catch rate = (attacks_caught / total_attacks) measures gate effectiveness.
+"""
+
+import json
+import hashlib
+import unittest
+from datetime import datetime, timezone, timedelta
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+
+from specimen_intake_evaluator import (
+    SpecimenIntakeEvaluator, SpecimenInput, BehavioralObservations,
+    ImprovementTrajectory, ReceiptStatus, EvaluationStatus, utcnow
+)
+
+
+class TestAdversarialAttack1ForgedHash(unittest.TestCase):
+    """Attack 1: Forged receipt hash (hash doesn't match content)."""
+
+    def setUp(self):
+        self.signer = Ed25519PrivateKey.generate()
+        self.ev = SpecimenIntakeEvaluator("specimen-adv-1", ratifier_public_key=self.signer.public_key())
+
+        # Create a valid intake record
+        si = SpecimenInput(
+            datetime(2026, 9, 13, tzinfo=timezone.utc),
+            datetime(2026, 9, 19, tzinfo=timezone.utc),
+            platform="micro1", tasks_assigned=25, tasks_completed=24, tasks_revised=3,
+            task_categories=["data-pipeline-annotation"]
+        )
+        obs = BehavioralObservations(
+            0.96, 0.25, 12.5, 87.0, 0.94, 0.08, 0.06, 0.67,
+            ImprovementTrajectory.IMPROVING, "increasing"
+        )
+        self.record = self.ev.create_intake_record(1, si, obs)
+        self.ev.generate_molt_predictions(self.record)
+        self.ev.generate_credpolicy_recommendation(self.record)
+        receipt, _ = self.ev.compute_receipt(self.record)
+        self.original_receipt = receipt
+
+    def test_attack1_forged_hash_detected_on_ratification(self):
+        """Forged receipt hash should be caught at ratification time."""
+        # Attacker tries to publish with a forged receipt hash
+        forged_hash = "0" * 64  # All zeros — obviously invalid
+        self.record.receipt_hash = forged_hash
+
+        # Attempt to ratify with forged hash
+        t = utcnow()
+        payload = self.ev.ratification_payload(forged_hash, "Z2", t)
+        sig = self.signer.sign(payload).hex()
+
+        # Ratification should fail because the hash doesn't match the record
+        with self.assertRaises(Exception) as ctx:
+            self.ev.ratify(self.record, "Z2", t, sig)
+
+        # The error should indicate record mutation (hash mismatch)
+        self.assertIn("mutated", str(ctx.exception).lower())
+
+    def test_attack1_forged_hash_blocks_publication(self):
+        """Publication should refuse a record with forged receipt hash."""
+        # Set up a valid ratification first
+        t = utcnow()
+        sig = self.signer.sign(
+            self.ev.ratification_payload(self.original_receipt, "Z2", t)
+        ).hex()
+        self.ev.ratify(self.record, "Z2", t, sig)
+
+        # Now attacker forges the hash after ratification
+        self.record.receipt_hash = "0" * 64
+
+        # Publication should fail because compute_hash() won't match
+        published = self.ev.publish_record(self.record)
+        self.assertFalse(published, "Forged hash should block publication")
+
+    def test_attack1_forged_hash_fails_verification(self):
+        """Forged hash should fail signature verification on publish."""
+        # Compute correct receipt
+        receipt, _ = self.ev.compute_receipt(self.record)
+        t = utcnow()
+        sig = self.signer.sign(
+            self.ev.ratification_payload(receipt, "Z2", t)
+        ).hex()
+
+        # Ratify with correct hash
+        self.ev.ratify(self.record, "Z2", t, sig)
+
+        # Try to forge the hash and verify
+        forged = "f" * 64
+        verified = self.ev._verify_ratification_signature(forged, "Z2", t, sig)
+        self.assertFalse(verified, "Forged hash should not verify")
+
