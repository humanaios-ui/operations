+class TestAdversarialAttack3ReplayedReceipt(unittest.TestCase):
+    """Attack 3: Replayed receipt (same receipt_hash submitted twice)."""
+
+    def setUp(self):
+        self.signer = Ed25519PrivateKey.generate()
+        self.ev = SpecimenIntakeEvaluator("specimen-adv-3", ratifier_public_key=self.signer.public_key())
+
+        si = SpecimenInput(
+            datetime(2026, 9, 13, tzinfo=timezone.utc),
+            datetime(2026, 9, 19, tzinfo=timezone.utc),
+            platform="micro1", tasks_assigned=25, tasks_completed=24, tasks_revised=3,
+            task_categories=["data-pipeline-annotation"]
+        )
+        obs = BehavioralObservations(
+            0.96, 0.25, 12.5, 87.0, 0.94, 0.08, 0.06, 0.67,
+            ImprovementTrajectory.IMPROVING, "increasing"
+        )
+        self.record = self.ev.create_intake_record(1, si, obs)
+        self.ev.generate_molt_predictions(self.record)
+        self.ev.generate_credpolicy_recommendation(self.record)
+        receipt, _ = self.ev.compute_receipt(self.record)
+
+        # Ratify and publish the first cycle
+        t = utcnow()
+        sig = self.signer.sign(self.ev.ratification_payload(receipt, "Z2", t)).hex()
+        self.ev.ratify(self.record, "Z2", t, sig)
+        self.ev.publish_record(self.record)
+
+        self.receipt_hash = receipt
+
+    def test_attack3_replayed_receipt_blocked(self):
+        """The same receipt_hash should not be publishable twice."""
+        # Create a second record for cycle 2
+        si = SpecimenInput(
+            datetime(2026, 9, 20, tzinfo=timezone.utc),
+            datetime(2026, 9, 26, tzinfo=timezone.utc),
+            platform="micro1", tasks_assigned=25, tasks_completed=24, tasks_revised=3,
+            task_categories=["data-pipeline-annotation"]
+        )
+        obs = BehavioralObservations(
+            0.96, 0.25, 12.5, 87.0, 0.94, 0.08, 0.06, 0.67,
+            ImprovementTrajectory.IMPROVING, "increasing"
+        )
+        record2 = self.ev.create_intake_record(2, si, obs)
+        self.ev.generate_molt_predictions(record2)
+        self.ev.generate_credpolicy_recommendation(record2)
+        receipt2, _ = self.ev.compute_receipt(record2)
+
+        # Attacker tries to forge record2's receipt_hash to match the published one
+        record2.receipt_hash = self.receipt_hash
+
+        t = utcnow()
+        # Try to ratify with the forged (replayed) receipt
+        sig = self.signer.sign(
+            self.ev.ratification_payload(self.receipt_hash, "Z2", t)
+        ).hex()
+
+        # Ratification should fail because the hash doesn't match the record
+        with self.assertRaises(Exception):
+            self.ev.ratify(record2, "Z2", t, sig)
+
+    def test_attack3_receipt_chaining_prevents_replay(self):
+        """Chain linking (chain_link_prior) in receipt hash prevents replay."""
+        # First record's receipt is in the chain
+        receipt1 = self.record.receipt_hash
+
+        # Second record should have receipt1 as its chain_link_prior
+        si = SpecimenInput(
+            datetime(2026, 9, 20, tzinfo=timezone.utc),
+            datetime(2026, 9, 26, tzinfo=timezone.utc),
+            platform="micro1", tasks_assigned=25, tasks_completed=24, tasks_revised=3,
+            task_categories=["data-pipeline-annotation"]
+        )
+        obs = BehavioralObservations(
+            0.96, 0.25, 12.5, 87.0, 0.94, 0.08, 0.06, 0.67,
+            ImprovementTrajectory.IMPROVING, "increasing"
+        )
+        record2 = self.ev.create_intake_record(2, si, obs)
+
+        # Verify chain linking
+        self.assertEqual(record2.chain_link_prior, receipt1, "Chain should link to prior receipt")
+
+        # Computing hash with the chain link included makes replay impossible
+        self.ev.generate_molt_predictions(record2)
+        self.ev.generate_credpolicy_recommendation(record2)
+        receipt2, _ = self.ev.compute_receipt(record2)
+
+        # receipt2's hash includes the chain_link_prior, so it's different from receipt1
+        self.assertNotEqual(receipt2, receipt1, "Chained receipts must differ")
+
