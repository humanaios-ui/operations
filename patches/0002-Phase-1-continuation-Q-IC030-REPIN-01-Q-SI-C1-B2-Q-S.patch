+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "schema_version": "1.0",
+  "description": "HumanAIOS specimen-intake Bayesian prior constants, v0.2 per specimen-intake.yml",
+  "constants": [
+    {
+      "name": "PRIOR_QUALITY",
+      "description": "Bayesian prior for specimen quality in task performance assessments",
+      "scope": "specimen-intake",
+      "current_value": 0.75,
+      "prior_value": 0.75,
+      "prior_version": "specimen-intake v0.2 genesis",
+      "value_type": "float",
+      "valid_range": [0.0, 1.0],
+      "molt_id": null,
+      "molt_history": [],
+      "ratified_at": null,
+      "trigger": {
+        "metric": "quality_forecast_error_rate",
+        "condition": "Forecast error on quality > 0.25 for 3+ consecutive cycles",
+        "measurement_window_days": 7,
+        "threshold": 0.25
+      },
+      "falsifier": "After molt window closes: mean quality error > 0.3 OR quality accuracy deteriorates < 70% accuracy",
+      "measurement_window_days": 14,
+      "revert_rule": {
+        "kind": "abs_above",
+        "threshold": 0.30,
+        "metric": "mean_squared_error"
+      },
+      "notes": "Hypothesis: starting at 0.75 captures baseline expert performer prior. If observed quality consistently beats this, propose increase. If falls below, decrease."
+    },
+    {
+      "name": "PRIOR_ACCEPTANCE",
+      "description": "Bayesian prior for specimen task acceptance rate",
+      "scope": "specimen-intake",
+      "current_value": 0.85,
+      "prior_value": 0.85,
+      "prior_version": "specimen-intake v0.2 genesis",
+      "value_type": "float",
+      "valid_range": [0.0, 1.0],
+      "molt_id": null,
+      "molt_history": [],
+      "ratified_at": null,
+      "trigger": {
+        "metric": "acceptance_rate_drift",
+        "condition": "Observed acceptance rate diverges from prior > 0.15 for 2+ cycles",
+        "measurement_window_days": 7,
+        "threshold": 0.15
+      },
+      "falsifier": "After molt window closes: acceptance prediction error > 0.2 OR actual acceptance rate stays ±0.05 of new prior",
+      "measurement_window_days": 14,
+      "revert_rule": {
+        "kind": "abs_above",
+        "threshold": 0.20,
+        "metric": "prediction_error"
+      },
+      "notes": "RQ2 in specimen-intake.yml uses CredPolicy (resource allocation model) forecasts. This constant anchors the prior for 'will specimen accept the offered task'."
+    },
+    {
+      "name": "SHRINK",
+      "description": "Shrinkage/regularization factor for Bayesian posterior estimates",
+      "scope": "specimen-intake",
+      "current_value": 0.3,
+      "prior_value": 0.3,
+      "prior_version": "specimen-intake v0.2 genesis",
+      "value_type": "float",
+      "valid_range": [0.0, 1.0],
+      "molt_id": null,
+      "molt_history": [],
+      "ratified_at": null,
+      "trigger": {
+        "metric": "posterior_variance_signal",
+        "condition": "Posterior variance (credible interval width) stays > 0.5 for 3+ cycles (indicates under-shrinkage)",
+        "measurement_window_days": 21,
+        "threshold": 0.5
+      },
+      "falsifier": "After molt window closes: credible interval width does not improve (shrink did not reduce variance) OR overfitting appears (validation error > training error by >0.15)",
+      "measurement_window_days": 21,
+      "revert_rule": {
+        "kind": "abs_above",
+        "threshold": 0.15,
+        "metric": "validation_train_error_gap"
+      },
+      "notes": "Controls Bayesian shrinkage: posterior = λ * prior + (1-λ) * observed, where λ = SHRINK. Low values (0.0-0.4) trust data more; high (0.7-1.0) trust prior. Hypothesis: 0.3 balances rapid learning (specimen new) with prior knowledge (expert pool)."
+    }
+  ],
+  "metadata": {
+    "created_at": "2026-09-10T00:00:00Z",
