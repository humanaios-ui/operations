@prefix cal: <https://humanaios.ai/ns/calibration#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://humanaios.ai/fixtures/calibration/> .

# 1. Convergent trace
ex:trial-convergent a cal:CalibrationTrial ;
  cal:hasStimulus ex:stim-c0 ;
  cal:hasHumanTrace ex:trace-c0 ;
  cal:hasMachineTrace ex:machine-c0 ;
  cal:hasComparison ex:compare-c0 ;
  cal:hasResolutionEvent ex:resolution-c0 ;
  cal:traceFrozenAt "2026-09-30T12:00:00Z"^^xsd:dateTime .

ex:stim-c0 a cal:Stimulus .
ex:trace-c0 a cal:HumanTrace ; cal:reportedValue "8" .
ex:machine-c0 a cal:MachineTrace ; cal:machineValue "8" .
ex:resolution-c0 a cal:ResolutionEvent ;
  cal:resolutionState cal:Resolved ;
  cal:participantConfidence "0.95"^^xsd:decimal ;
  cal:sequenceIndex 0 .
ex:compare-c0 a cal:Comparison ; cal:comparisonType cal:Convergence .

# 2. Divergence
ex:trial-divergent a cal:CalibrationTrial ;
  cal:hasStimulus ex:stim-p0 ;
  cal:hasHumanTrace ex:trace-p0 ;
  cal:hasMachineTrace ex:machine-p0 ;
  cal:hasComparison ex:compare-p0 ;
  cal:hasResolutionEvent ex:resolution-p0 ;
  cal:traceFrozenAt "2026-09-30T12:01:00Z"^^xsd:dateTime .

ex:stim-p0 a cal:Stimulus .
ex:trace-p0 a cal:HumanTrace ; cal:reportedValue "13" .
ex:machine-p0 a cal:MachineTrace ; cal:machineValue "4" .
ex:resolution-p0 a cal:ResolutionEvent ;
  cal:resolutionState cal:Resolved ;
  cal:participantConfidence "0.25"^^xsd:decimal ;
  cal:sequenceIndex 1 .
ex:compare-p0 a cal:Comparison ; cal:comparisonType cal:Divergence .

# 3. Unresolved
ex:trial-unresolved a cal:CalibrationTrial ;
  cal:hasStimulus ex:stim-u0 ;
  cal:hasHumanTrace ex:trace-u0 ;
  cal:hasComparison ex:compare-u0 ;
  cal:hasResolutionEvent ex:resolution-u0 ;
  cal:traceFrozenAt "2026-09-30T12:02:00Z"^^xsd:dateTime .

ex:stim-u0 a cal:Stimulus .
ex:trace-u0 a cal:HumanTrace .
ex:resolution-u0 a cal:ResolutionEvent ;
  cal:resolutionState cal:Unresolved ;
  cal:sequenceIndex 0 .
ex:compare-u0 a cal:Comparison ; cal:comparisonType cal:Indeterminate .

# 4. Delayed resolution preserves the earlier unresolved event
ex:trial-delayed a cal:CalibrationTrial ;
  cal:hasStimulus ex:stim-d0 ;
  cal:hasHumanTrace ex:trace-d0 ;
  cal:hasMachineTrace ex:machine-d0 ;
  cal:hasComparison ex:compare-d0 ;
  cal:hasResolutionEvent ex:resolution-d0-initial, ex:resolution-d0-later ;
  cal:traceFrozenAt "2026-09-30T12:03:00Z"^^xsd:dateTime .

ex:stim-d0 a cal:Stimulus .
ex:trace-d0 a cal:HumanTrace .
ex:machine-d0 a cal:MachineTrace ; cal:machineValue "4" .
ex:resolution-d0-initial a cal:ResolutionEvent ;
  cal:resolutionState cal:Unresolved ;
  cal:sequenceIndex 0 .
ex:resolution-d0-later a cal:ResolutionEvent ;
  cal:resolutionState cal:Delayed ;
  cal:reportedValue "13" ;
  cal:participantConfidence "0.20"^^xsd:decimal ;
  cal:sequenceIndex 1 ;
  cal:follows ex:resolution-d0-initial .
ex:compare-d0 a cal:Comparison ; cal:comparisonType cal:Divergence .

# 5. Environmental/context event is contextual, not causal
ex:trial-context a cal:CalibrationTrial ;
  cal:hasStimulus ex:stim-env ;
  cal:hasHumanTrace ex:trace-env ;
  cal:hasContextObservation ex:context-env ;
  cal:hasResolutionEvent ex:resolution-env ;
  cal:hasComparison ex:compare-env ;
  cal:traceFrozenAt "2026-09-30T12:04:00Z"^^xsd:dateTime .

ex:stim-env a cal:Stimulus .
ex:trace-env a cal:HumanTrace .
ex:context-env a cal:ContextObservation ;
  cal:contextFor ex:trial-context .
ex:resolution-env a cal:ResolutionEvent ;
  cal:resolutionState cal:Unresolved ;
  cal:sequenceIndex 0 .
ex:compare-env a cal:Comparison ; cal:comparisonType cal:Interference .

# 6. Design delta that fails retest
ex:trial-delta-fail a cal:CalibrationTrial ;
  cal:hasStimulus ex:stim-fail ;
  cal:hasHumanTrace ex:trace-fail ;
  cal:generatedDesignDelta ex:delta-fail ;
  cal:traceFrozenAt "2026-09-30T12:05:00Z"^^xsd:dateTime .

ex:stim-fail a cal:Stimulus .
ex:trace-fail a cal:HumanTrace .
ex:delta-fail a cal:DesignDelta ;
  cal:warrantState cal:Withdrawn ;
  cal:supportedByFrozenTrace ex:trace-fail ;
  cal:falsifier "Fresh-symbol retest does not reproduce the effect." ;
  cal:retestOutcome "FAILED_TO_REPLICATE" .

# 7. Replicated design delta
ex:trial-delta-replicated a cal:CalibrationTrial ;
  cal:hasStimulus ex:stim-repl ;
  cal:hasHumanTrace ex:trace-repl ;
  cal:generatedDesignDelta ex:delta-repl ;
  cal:traceFrozenAt "2026-09-30T12:06:00Z"^^xsd:dateTime .

ex:stim-repl a cal:Stimulus .
ex:trace-repl a cal:HumanTrace .
ex:delta-repl a cal:DesignDelta ;
  cal:warrantState cal:Replicated ;
  cal:supportedByFrozenTrace ex:trace-repl ;
  cal:falsifier "Independent fresh-baseline retest reverses the observed benefit." ;
  cal:retestOutcome "REPLICATED" .
